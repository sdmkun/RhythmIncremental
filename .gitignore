# Godot 4+ specific ignores
.godot/
/android/

# Exported / build artifacts
export.cfg
export_presets.cfg
*.translation

# Mono / .NET (unused here, kept for safety)
.mono/
data_*/

# OS / editor cruft
.DS_Store
Thumbs.db
*.tmp

# --- Large installed addons (install locally via each addon's INSTALL.md) ---
# Project-DJ-Godot ships ~723 MB of prebuilt Git-LFS binaries; don't commit it.
# The tracked placeholders keep only the INSTALL.md guides.
/addons/Project_DJ_Godot/*
!/addons/Project_DJ_Godot/INSTALL.md

/audio/loops/